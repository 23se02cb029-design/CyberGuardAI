# Production Environment Configuration Template
# Do NOT place real secrets in this file.

# Node environment & Server port
NODE_ENV=production
PORT=3000

# PostgreSQL database connection string (Neon, Supabase, Railway, Render Postgres, etc.)
# If left empty, CyberGuard AI automatically operates with persistent local JSON storage.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign session JWTs — generate a random 32-byte hex string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: set to your email before first signup to grant Administrator role automatically
OWNER_OPEN_ID=admin@your-domain.com

# Password Reset & Email Configuration
RESET_TOKEN_EXPIRY_MINUTES=30
EMAIL_FROM=noreply@your-domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional: Google Gemini API Key for LLM-assisted threat reasoning
# If unavailable or rate-limited, CyberGuard AI automatically uses its offline rule-based heuristic engine.
GEMINI_API_KEY=
